---
export const props = {
  /**
   * Call to action section props
   */
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonUrl?: string;
};
---
<section class="py-16 bg-green-600">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold text-white sm:text-4xl">
      {props.title ?? "Siap Menjadiri Usaha Anda?"}
    </h2>
    {props.subtitle && <p class="mt-4 text-lg text-green-50 max-w-2xl mx-auto">{props.subtitle}</p>}
    <div class="mt-8">
      <a href={props.buttonUrl ?? "/daftar"} class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-white hover:bg-green-50 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white">
        {props.buttonText ?? "Daftar Bisnis Sekarang"}
      </a>
    </div>
  </div>
</section>