---
export const props = {
  /**
   * Hero section props
   */
  title: string;
  subtitle?: string;
  image?: string;
};
---
<div class="relative bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">
        {props.title}
      </h1>
      {props.subtitle && <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">{props.subtitle}</p>}
      {props.image && (
        <div class="mt-8">
          <img src={props.image} alt="UMKM businesses" class="rounded-lg shadow-lg" />
        </div>
      )}
      <div class="mt-8">
        <a href="/daftar" class="inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
          Daftar Bisnis UMKM
        </a>
      </div>
    </div>
  </div>
</div>